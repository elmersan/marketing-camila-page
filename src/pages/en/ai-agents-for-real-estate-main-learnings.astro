---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InsightsArticle from "../../components/InsightsArticle.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import heroCopy from "../../i18n/en/hero.json";
import footerCopy from "../../i18n/en/footer.json";
const title = "Implementing AI agents in Peruvian real estate companies";
const description = "The main challenges and lessons from implementing conversational AI agents to expand the capacity of sales advisors in real estate projects.";
