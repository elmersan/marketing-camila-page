---
import "../styles/global.css";

interface Props {
  lang: "en" | "es";
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fefcfb" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
