---
import { LanguagesIcon } from "./icons/LanguagesIcon";

interface HeaderCopy {
  locale: string;
  languageLabel: string;
  languageName: string;
  languageHref: string;
  brandHref: string;
  nav: {
    capabilities: string;
    preLaunch: string;
    documentation: string;
    pricing: string;
    createAccount: string;
    signIn: string;
  };
}

interface Props {
  data: HeaderCopy;
  homeHref?: string;
  pricingHref?: string;
}

const { data, homeHref = "", pricingHref } = Astro.props;
const capabilitiesHref = `${homeHref}#capabilities`;
const preLaunchHref = `${homeHref}#pilot-program`;
const plansHref = pricingHref ?? (data.locale === "es" ? "/planes-de-suscripcion/" : "/en/subscription-plans/");
---

<header class="site-header">
  <div class="header-inner">
    <div class="brand-group">
      <a class="brand-mark" href={data.brandHref} aria-label="BrandLift home">BRANDLIFT</a>
      <details class="language-menu">
        <summary class="language-switch" aria-label={`Open language menu. Current language: ${data.languageLabel}`} aria-haspopup="menu">
          <LanguagesIcon client:idle className="language-icon" size={14} aria-hidden="true" />
          <span>{data.languageLabel}</span>
        </summary>
        <div class="language-options" role="menu">
          <a class="language-option" href={data.languageHref} role="menuitem">{data.languageName}</a>
        </div>
      </details>
    </div>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={capabilitiesHref}>{data.nav.capabilities}</a>
      <a href={preLaunchHref}>{data.nav.preLaunch}</a>
      <a href="https://camila-eeca23b9.mintlify.io" target="_blank" rel="noreferrer">{data.nav.documentation}</a>
      <a href={plansHref}>{data.nav.pricing}</a>
    </nav>

    <div class="header-actions">
      <a class="header-link create-account" href="https://camila.brandlift.pe/signup">{data.nav.createAccount}</a>
      <a class="button button-primary header-sign-in" href="https://camila.brandlift.pe/login">{data.nav.signIn}</a>
    </div>
  </div>
</header>
