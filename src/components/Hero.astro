---
interface HeroCopy {
  locale: string;
  languageLabel: string;
  languageName: string;
  languageHref: string;
  brandHref: string;
  nav: {
    capabilities: string;
    preLaunch: string;
    documentation: string;
    pricing: string;
    createAccount: string;
    signIn: string;
  };
  announcement: string;
  headline: {
    lineOne: string;
    lineTwoPrefix: string;
    accent: string;
  };
  description: string;
  primaryCta: string;
  secondaryCta: string;
  location: string;
  partnerLabel: string;
  partnerAlt: string;
}

interface Props {
  data: HeroCopy;
}

const { data } = Astro.props;
---

<section class="hero" data-locale={data.locale} aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-announcement" role="note" data-hero-announcement>
      <span>{data.announcement}</span>
      <button
        class="hero-announcement-close"
        type="button"
        aria-label={data.locale === "es" ? "Cerrar anuncio" : "Close announcement"}
        data-hero-announcement-close
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <picture class="hero-image-frame" aria-hidden="true">
      <source srcset="/images/camila-abstract-gradient-hero.webp" type="image/webp" />
      <img
        class="hero-image"
        src="/images/camila-abstract-gradient-hero.png"
        alt=""
        width="1607"
        height="979"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-content">
      <div class="hero-card">
        <div class="hero-card-location">{data.location}</div>
        <div class="hero-copy">
          <h1 id="hero-title">
            <span class="headline-line">{data.headline.lineOne}</span>
            <span class="headline-line">
              {data.headline.lineTwoPrefix}<span class="headline-accent">{data.headline.accent}</span>
            </span>
          </h1>
          <p class="hero-description">{data.description}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#pilot-program">
              <span>{data.primaryCta}</span>
            </a>
            <a class="button button-secondary" href="https://wa.me/51968781139">{data.secondaryCta}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-partner" aria-label={data.partnerLabel}>
      <span class="hero-partner-label">{data.partnerLabel}</span>
      <a href="https://emprelatam.com" target="_blank" rel="noreferrer">
        <img src="/images/emprelatam-logo.png" alt={data.partnerAlt} width="180" height="36" loading="eager" decoding="async" />
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero-announcement]").forEach((announcement) => {
    const closeButton = announcement.querySelector<HTMLButtonElement>("[data-hero-announcement-close]");

    closeButton?.addEventListener("click", () => {
      announcement.hidden = true;
    });
  });
</script>
